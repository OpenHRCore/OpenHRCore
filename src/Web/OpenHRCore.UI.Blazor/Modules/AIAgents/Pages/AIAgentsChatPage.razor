@page "/chat"
@using Microsoft.AspNetCore.SignalR.Client
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>AI Chat</PageTitle>

<MudText Typo="Typo.h6" Style="font-weight:bold;">AI Agents</MudText>
<MudText Typo="Typo.body2" Class="mb-4">This page is an AI agent chat page.</MudText>

<MudPaper Class="d-flex flex-column" Style="height: 75vh;" Elevation="0">
    <!-- Chat Scroll Area -->
    <MudPaper Class="flex-grow-1 overflow-y-auto pa-10 mb-5" Elevation="1">
        @foreach (var message in _messages)
        {
            <MudChat Variant="Variant.Text"
                     Color="@(message.IsAgent ? Color.Dark : Color.Primary)"
                     ArrowPosition="ChatArrowPosition.Middle"
                     ChatPosition="@(message.IsAgent ? ChatBubblePosition.Start : ChatBubblePosition.End)">
                <MudAvatar Color="@(message.IsAgent? Color.Error: Color.Primary)">
                    @if (message.IsAgent)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.SmartToy" />
                    }
                    else
                    {
                        @NameHelper.GetInitials(message.User)
                    }
                </MudAvatar>
                <MudChatBubble>
                    <MudMarkdown Value="@message.Text" />

                    @if (!string.IsNullOrWhiteSpace(message.ThinkText))
                    {
                        <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Secondary"
                                   OnClick="@(() => ToggleThink(message))">
                            @(message.ShowThink ? "Hide 🧠 Reasoning" : "Show 🧠 Reasoning")
                        </MudButton>

                        <MudCollapse Expanded="message.ShowThink">
                            <MudPaper Class="mt-1 p-2" Style="background-color: #f5f5f5;">
                                <em><strong>&lt;think&gt;</strong> @message.ThinkText <strong>&lt;/think&gt;</strong></em>
                            </MudPaper>
                        </MudCollapse>
                    }
                </MudChatBubble>
            </MudChat>
        }

        @if (_isLoading)
        {
            <MudChat Variant="Variant.Text" Color="Color.Dark" ArrowPosition="ChatArrowPosition.Middle" ChatPosition="ChatBubblePosition.Start">
                <MudAvatar Color="Color.Error">
                    <MudIcon Icon="@Icons.Material.Filled.SmartToy" />
                </MudAvatar>
                <MudChatBubble>
                    <MudText Typo="Typo.body2">AI is typing...</MudText>
                </MudChatBubble>
            </MudChat>
        }
    </MudPaper>

    <!-- Input Area -->
    <MudPaper Class="pa-2" Elevation="0">
        <MudTextField T="string"
                      @bind-Value="_input"
                      Placeholder="Type your message..."
                      Variant="Variant.Outlined"
                      Adornment="Adornment.End"
                      AdornmentIcon="@Icons.Material.Outlined.Chat"
                      OnKeyDown="OnInputKeyDownAsync"
                      OnAdornmentClick="SendAsync"
                      Immediate="true"
                      TextUpdateSuppression="false"
                      InputType="InputType.Text"
                      Clearable="true"
                      AutoFocus="true"
                      FullWidth="true"
                      Class="rounded-lg" />
    </MudPaper>
</MudPaper>

@code {
    private readonly string _userName = "Stephen Kyaw";
    private List<ChatMessage> _messages = new();
    private string _input = string.Empty;
    private bool _isLoading;
    private HubConnection? _hubConnection;

    private const string AI_USER = "AI";
    private const string SYSTEM_USER = "System";

    protected override async Task OnInitializedAsync()
    {
        _hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/chathub"))
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On<string, string>("ReceiveMessage", (user, message) =>
        {
            var parsed = ParseMessage(user, message);
            _messages.Add(parsed);
            InvokeAsync(StateHasChanged);
        });

        _hubConnection.On<string, string>("ReceiveStreamedToken", (user, token) =>
        {
            var last = _messages.LastOrDefault();

            if (last != null && last.User == user && last.IsAgent)
            {
                _isLoading = false;
                last.Text += token;

                if (token.Contains("</think>"))
                {
                    var parsed = ParseMessage(user, last.Text);
                    last.Text = parsed.Text;
                    last.ThinkText = parsed.ThinkText;
                }
            }
            else
            {
                _messages.Add(new ChatMessage { User = user, Text = token });
            }

            InvokeAsync(StateHasChanged);
        });

        await _hubConnection.StartAsync();
    }

    private ChatMessage ParseMessage(string user, string rawText)
    {
        var message = new ChatMessage { User = user, Text = rawText };

        const string startTag = "<think>";
        const string endTag = "</think>";

        int start = rawText.IndexOf(startTag, StringComparison.OrdinalIgnoreCase);
        int end = rawText.IndexOf(endTag, StringComparison.OrdinalIgnoreCase);

        if (start >= 0 && end > start)
        {
            message.ThinkText = rawText.Substring(start + startTag.Length, end - start - startTag.Length).Trim();
            message.Text = rawText.Remove(start, (end + endTag.Length) - start).Trim();
        }

        return message;
    }

    private async Task OnInputKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendAsync();
        }
    }

    private async Task SendAsync()
    {
        var message = _input?.Trim();

        if (string.IsNullOrWhiteSpace(message))
            return;

        _isLoading = true;
        _input = string.Empty;

        if (_hubConnection is not null && _hubConnection.State == HubConnectionState.Connected)
        {
            await _hubConnection.SendAsync("SendMessage", _userName, message);
        }
        else
        {
            _messages.Add(new ChatMessage
            {
                User = SYSTEM_USER,
                Text = "⚠️ Connection not established."
            });
        }

        await InvokeAsync(StateHasChanged);
    }

    private void ToggleThink(ChatMessage message)
    {
        message.ShowThink = !message.ShowThink;
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
        }
    }
}
