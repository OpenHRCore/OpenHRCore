@page "/chat"
@using Microsoft.AspNetCore.SignalR.Client
@using System.Net.Http
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>AI Chat</PageTitle>

<MudText Typo="Typo.h6" Style="font-weight:bold;">AI Agents</MudText>
<MudText Typo="Typo.body2" Class="mb-4">This page is an AI agent chat page.</MudText>

<MudPaper Class="d-flex flex-column" Style="height: 75vh;" Elevation="0">

    <!-- Scrollable Chat Message Area -->
    <MudPaper Class="flex-grow-1 overflow-y-auto pa-10 mb-5" Elevation="1">
        @foreach (var msg in ChatMessages)
        {
            <MudChat Variant="Variant.Text"
                     Color="@(msg.IsAgent ? Color.Dark : Color.Primary)"
                     ArrowPosition="ChatArrowPosition.Middle"
                     ChatPosition="@(msg.IsAgent ? ChatBubblePosition.Start : ChatBubblePosition.End)">
                <MudAvatar Color="@(msg.IsAgent? Color.Error: Color.Primary)">
                    @if (msg.IsAgent)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.SmartToy" />
                    }
                    else
                    {
                        @NameHelper.GetInitials(msg.User)
                    }

                </MudAvatar>
                <MudChatBubble>
                    <MudMarkdown Value="@msg.Text" />
                </MudChatBubble>
            </MudChat>
        }

        @if (isLoading)
        {
            <MudChat Variant="Variant.Text" Color="Color.Dark" ArrowPosition="ChatArrowPosition.Middle" ChatPosition="ChatBubblePosition.Start">
                <MudAvatar Color="Color.Error">
                    <MudIcon Icon="@Icons.Material.Filled.SmartToy" />
                </MudAvatar>
                <MudChatBubble>
                    <MudText Typo="Typo.body2">AI is typing...</MudText>
                </MudChatBubble>
            </MudChat>
        }
    </MudPaper>

    <!-- Input Box Area -->
    <MudPaper Class="pa-2" Elevation="0">
        <MudTextField T="string"
                      @bind-Value="_chatMessage"
                      Placeholder="Type your message..."
                      Variant="Variant.Outlined"
                      Adornment="Adornment.End"
                      AdornmentIcon="@Icons.Material.Outlined.Chat"
                      KeyDownPreventDefault="_keyDownPreventDefault"
                      OnKeyDown="OnKeyDownAsync"
                      OnAdornmentClick="OnAdornmentClick"
                      Immediate="true"
                      TextUpdateSuppression=false
                      InputType="InputType.Text"
                      Clearable="true"
                      AutoFocus="true"
                      FullWidth="true"
                      Class="rounded-lg" />
    </MudPaper>

</MudPaper>



@code {
    private bool isLoading = false;
    private bool _keyDownPreventDefault = true;
    private string _userName { get; set; } = "Stephen Kyaw";
    private string _chatMessage { get; set; } = string.Empty;
    private HubConnection? _hubConnection = null;
    private List<ChatMessage> ChatMessages { get; set; } = new List<ChatMessage>();

    private class ChatMessage
    {
        public string User { get; set; } = string.Empty;
        public string Text { get; set; } = string.Empty;
        public bool IsAgent => User == "AI";
    }

    private async Task OnAdornmentClick()
    {
        await SendMessageToHubAsync(_userName, _chatMessage);
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            isLoading = true;
            _keyDownPreventDefault = true;
            await SendMessageToHubAsync(_userName, _chatMessage);

            _chatMessage = string.Empty;
            await InvokeAsync(StateHasChanged);
        }
        else
        {
            _keyDownPreventDefault = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/chathub"))
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On<string, string>("ReceiveMessage", (user, message) =>
        {
            ChatMessages.Add(new ChatMessage { User = user, Text = message });
            InvokeAsync(StateHasChanged);
        });

        _hubConnection.On<string, string>("ReceiveStreamedToken", (user, token) =>
        {
            var last = ChatMessages.LastOrDefault();

            if (last != null && last.User == user && last.IsAgent)
            {
                isLoading = false;
                last.Text += token;
            }
            else
            {
                ChatMessages.Add(new ChatMessage { User = user, Text = token });
            }

            InvokeAsync(StateHasChanged);
        });

        await _hubConnection.StartAsync();
    }


    private async Task SendMessageToHubAsync(string userName, string message)
    {

        if (string.IsNullOrWhiteSpace(message))
            return;

        if (_hubConnection is not null && _hubConnection.State == HubConnectionState.Connected)
        {
            await _hubConnection.SendAsync("SendMessage", userName, message);
        }
        else
        {
            ChatMessages.Add(new ChatMessage { User = "System", Text = "⚠️ Connection not established." });
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
        }
    }
}
