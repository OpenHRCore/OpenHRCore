@inherits LayoutComponentBase
@using MudBlazor
<MudThemeProvider Theme="_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudLayout>

    <MudAppBar Elevation="0" Color="Color.Transparent">
        <MudIconButton Icon="@Icons.Material.Outlined.Menu" Color=Color.Inherit Edge="Edge.Start" OnClick="@ToggleDrawer" />

        <MudText Typo="Typo.h6" Style="font-weight:bold;">OpenHRCore</MudText>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Outlined.AutoAwesome" Color="Color.Primary" aria-label="chat" />
        <MudIconButton Icon="@Icons.Material.Outlined.Notifications" Color="Color.Inherit" aria-label="notifications" />
        <MudIconButton Icon="@Icons.Material.Outlined.Mail" Color="Color.Inherit" aria-label="messages" />
        <MudIconButton Icon="@(DarkLightModeButtonIcon)" Color="Color.Inherit" OnClick="@DarkModeToggle" />
        <MudMenu>
            <ActivatorContent>
                <MudBadge Color="Color.Success" Overlap="true" Bordered="true">
                    <MudAvatar Color="Color.Primary">SK</MudAvatar>
                </MudBadge>
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem>
                    <MudText Typo="Typo.subtitle2" Style="font-weight:bold;">Stephen Kyaw</MudText>
                    <MudText Typo="Typo.body2" Class="text-secondary">admin@openhrcore.com</MudText>
                </MudMenuItem>
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Outlined.People" Href="/profile">Profile</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.Settings" Href="/settings">Settings</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.Logout" Href="/logout">Logout</MudMenuItem>
            </ChildContent>
        </MudMenu>

    </MudAppBar>
    <MudDrawer Elevation="2" Height="98%" Class="rounded-lg mt-2 ml-2  overflow-hidden" Style="@($"border:1px solid {Colors.Gray.Lighten2}")" @bind-Open="@_open" ClipMode="@DrawerClipMode.Never" Variant="@DrawerVariant.Mini">
        <NavMenu IsMiniView=!_open />
    </MudDrawer>

    <MudMainContent Elevation="2" Style="height:100%;">
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="px-10 py-5">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _isExpanded = true;
    private bool _open = true;
    private void ToggleDrawer()
    {
        _open = !_open;
        _isExpanded = !_isExpanded;
    }

    private bool _isDarkMode = false;
    private MudTheme? _theme = null;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        StateHasChanged();


        _theme = new()
        {
            PaletteLight = _lightPalette,
            PaletteDark = _darkPalette,
            LayoutProperties = new LayoutProperties()
        };
    }
    private void DarkModeToggle()
    {
        _isDarkMode = !_isDarkMode;
    }

    private readonly PaletteLight _lightPalette = new()
    {
        Primary = Colors.Indigo.Darken2,         // #4338CA Indigo 700
        Secondary = Colors.Teal.Darken1,          // #00897B Teal 600
        Background = Colors.Gray.Lighten5,        // #F9FAFB Gray 50
        Surface = Colors.Gray.Lighten5,             // #FFFFFF
        AppbarBackground = Colors.Shades.White,
        AppbarText = Colors.Gray.Darken4,          // #111827 Gray 900
        DrawerBackground = Colors.Gray.Lighten5,
        DrawerText = Colors.Gray.Darken4,
        TextPrimary = Colors.Gray.Darken4,         // #111827
        TextSecondary = Colors.Gray.Darken1,       // #6B7280
        LinesDefault = Colors.Gray.Lighten2,       // #E5E7EB
        ActionDefault = Colors.Indigo.Darken2      // #4338CA
    };

    private readonly PaletteDark _darkPalette = new()
    {
        Primary = Colors.Blue.Darken2, // Medium Blue – calm, trustworthy accent 4F83CC
        Secondary = "#6FB3B8",         // Soft Teal – subtle supporting color
        Background = "#0D1117",        // Almost black with a slight blue tint
        Surface = "#161B22",           // Dark gray with blue undertones
        AppbarBackground = "#1B222D",  // Slightly lighter for subtle separation 1B222D
        AppbarText = "#C9D1D9",        // Soft light gray text
        DrawerBackground = "#161B22",  // Matches surface for consistency
        DrawerText = "#8B949E",        // Muted blue-gray text for sidebar
        TextPrimary = "#C9D1D9",       // Main text, soft white
        TextSecondary = "#6E7681",     // Secondary text, medium gray-blue
        LinesDefault = "#30363D",      // Subtle dividing lines
        ActionDefault = "#4F83CC"      // Accent for interactive elements
    };

    public string DarkLightModeButtonIcon => _isDarkMode switch
    {
        true => Icons.Material.Rounded.LightMode,
        false => Icons.Material.Outlined.DarkMode,
    };
}