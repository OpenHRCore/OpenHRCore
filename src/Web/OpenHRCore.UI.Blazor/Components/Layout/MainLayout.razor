@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Inherit"  Fixed=true>
        <MudIconButton Icon="@Icons.Material.Outlined.MenuOpen" Color=Color.Inherit Edge="Edge.Start" OnClick="@ToggleDrawer" />
        <MudText Typo="Typo.h6">OpenHRCore</MudText>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Outlined.Notifications" Color="Color.Inherit" aria-label="notifications" />
        <MudIconButton Icon="@Icons.Material.Outlined.Mail" Color="Color.Inherit" aria-label="messages" />
        <MudMenu>
            <ActivatorContent>
              
                <MudBadge Color="Color.Success" Overlap="true" Bordered="true">
                    <MudAvatar Color="Color.Inherit">SK</MudAvatar>
                </MudBadge>
            </ActivatorContent>
            <ChildContent>
               <div style="padding:1rem;">
                    <MudText Typo="Typo.subtitle2">Stephen Kyaw</MudText>
                    <MudText Typo="Typo.body2" Class="text-secondary">admin@openhrcore.com</MudText>
                    <MudDivider Class="my-2" />
                    <MudMenuItem Icon="@Icons.Material.Outlined.People" Href="/profile">Profile</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Outlined.Settings" Href="/settings">Settings</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Outlined.Logout" Href="/logout">Logout</MudMenuItem>
                </div>
            </ChildContent>
        </MudMenu>
    </MudAppBar>
    <MudDrawer @bind-Open="@_open">
        <MudDrawerContainer>
            <NavMenu />
        </MudDrawerContainer>
    </MudDrawer>
    <MudMainContent Elevation="2" Class="p-4">
        <MudContainer Class="m-4" >
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _open = true;
    private void ToggleDrawer()
    {
        _open = !_open;
    }
}