
<MudNavMenu>

    <MudMenu AnchorOrigin="@(IsShowMenuTitle? Origin.BottomCenter: Origin.BottomLeft)" TransformOrigin="@(IsShowMenuTitle? Origin.TopLeft : Origin.BottomLeft)">
            <ActivatorContent>
                <div style="display:flex; justify-content:space-between;align-items:center;padding-left:0.5rem; padding-top:1.5rem;padding-bottom:1.5rem;padding-right:1rem;">
                    <MudAvatar Color="Color.Primary">AB</MudAvatar>
                    <div class="pl-2">
                        <MudText Typo="Typo.subtitle2" Style="font-weight:bold;">ABC Company</MudText>
                        <MudText Typo="Typo.body2" Class="text-secondary">admin@openhrcore.com</MudText>
                    </div>
                    <MudIcon Class="mr-2" Icon="@Icons.Material.Outlined.UnfoldMore" />
                </div>
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem>
                    <MudText Typo="Typo.subtitle2" Style="font-weight:bold;">Company Information</MudText>
                    <MudText Typo="Typo.body2" Class="text-secondary">Manage Company Settings</MudText>
                </MudMenuItem>
                <MudDivider />
                <MudMenuItem Href="/">
                    <div style="display:flex;justify-content:space-between;align-items:center;padding-left:1rem; padding-right:1rem;">
                        <MudAvatar Color="Color.Tertiary">XY</MudAvatar>
                        <div class="pl-2">
                            <MudText Typo="Typo.subtitle2" Style="font-weight:bold;">XYZ Company</MudText>
                            <MudText Typo="Typo.body2" Class="text-secondary">xyz@openhrcore.com</MudText>
                        </div>
                    </div>
                </MudMenuItem>
                <MudMenuItem Href="/">
                    <div style="display:flex;justify-content:space-between;align-items:center;padding-left:1rem; padding-right:1rem;">
                        <MudAvatar Color="Color.Success">KT</MudAvatar>
                        <div class="pl-2">
                            <MudText Typo="Typo.subtitle2" Style="font-weight:bold;">KTT Company</MudText>
                            <MudText Typo="Typo.body2" Class="text-secondary">xyz@openhrcore.com</MudText>
                        </div>
                    </div>
                </MudMenuItem>
                <MudMenuItem Href="/">
                    <div style="display:flex;justify-content:space-between;align-items:center;padding-left:1rem; padding-right:1rem;">
                        <MudAvatar Color="Color.Warning">OP</MudAvatar>
                        <div class="pl-2">
                            <MudText Typo="Typo.subtitle2" Style="font-weight:bold;">OpenHRCore</MudText>
                            <MudText Typo="Typo.body2" Class="text-secondary">xyz@openhrcore.com</MudText>
                        </div>
                    </div>
                </MudMenuItem>
                <MudMenuItem>
                    <div style="display:flex;justify-content:center;align-items:center;">
                        <MudIcon Icon="@Icons.Material.Filled.Add" />
                        <MudText Class="text-secondary ml-2" Typo="Typo.body2">Add company</MudText>
                    </div>
                </MudMenuItem>
            </ChildContent>
        </MudMenu>

    <MudTooltip Text="Company Info" Inline="false"  Arrow="true" Placement="Placement.Right">
        
    </MudTooltip>
    <MudDivider />

    <MudTooltip Text="Dashboard" Inline="false" Arrow="true" Placement="Placement.Right">
        <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Dashboard" Href="">
            Dashboard
        </MudNavLink>
    </MudTooltip>

    @if (IsShowMenuTitle)
    {
        <MudNavGroup Title="Settings" Icon="@Icons.Material.Outlined.Settings" Expanded="true">
            <MudNavLink Icon="@Icons.Material.Outlined.People" Href="/admin/users">Users</MudNavLink>
            <MudNavLink Icon="@Icons.Material.Outlined.AdminPanelSettings" Href="/admin/roles">Roles</MudNavLink>
        </MudNavGroup>

        <MudNavGroup Title="Recruitment" Icon="@Icons.Material.Outlined.WorkHistory" Expanded="true">
            <MudNavLink Icon="@Icons.Material.Outlined.SettingsSuggest" Href="/recruitment/settings">Settings</MudNavLink>
            <MudNavLink Icon="@Icons.Material.Outlined.Draw" Href="/recruitment/pipeline">Pipeline</MudNavLink>
            <MudNavLink Icon="@Icons.Material.Outlined.Work" Href="/recruitment/job-posting">Job Posting</MudNavLink>
            <MudNavLink Icon="@Icons.Material.Outlined.ContactPage" Href="/recruitment/candidates">Candidates</MudNavLink>
            <MudNavLink Icon="@Icons.Material.Outlined.FindInPage" Href="/recruitment/job-application">Job Applications</MudNavLink>
        </MudNavGroup>
    }
    else
    {
        <MudMenu Variant="Variant.Filled">
            <ActivatorContent>
                <MudTooltip Text="Settings" Inline="false" Arrow="true" Placement="Placement.Right">
                    <MudNavLink Icon="@Icons.Material.Outlined.Settings">Settings</MudNavLink>
                </MudTooltip>
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem>
                    <MudText Typo="Typo.subtitle2" Style="font-weight:bold;">Settings</MudText>
                    <MudText Typo="Typo.body2" Class="text-secondary">Manage Application Settings</MudText>
                </MudMenuItem>
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Outlined.People" Href="/admin/users">Users</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.Lock" Href="/admin/roles">Roles</MudMenuItem>
            </ChildContent>
        </MudMenu>

        <MudMenu Variant="Variant.Filled">
            <ActivatorContent>
                <MudTooltip Text="Recruitment" Inline="false" Arrow="true" Placement="Placement.Right">
                    <MudNavLink Icon="@Icons.Material.Outlined.WorkHistory">Recruitment</MudNavLink>
                </MudTooltip>
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem>
                    <MudText Typo="Typo.subtitle2" Style="font-weight:bold;">Recruitment</MudText>
                    <MudText Typo="Typo.body2" Class="text-secondary">Manage Recruitment Module</MudText>
                </MudMenuItem>
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Outlined.SettingsSuggest" Href="/recruitment/settings">Settings</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.Draw" Href="/recruitment/pipeline">Pipeline</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.Work" Href="/recruitment/job-posting">Job Posting</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.ContactPage" Href="/recruitment/candidates">Candidates</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.FindInPage" Href="/recruitment/job-application">Job Applications</MudMenuItem>
            </ChildContent>
        </MudMenu>
    }

</MudNavMenu>

@code {
    [Parameter]
    public bool IsShowMenuTitle { get; set; } = false;
}