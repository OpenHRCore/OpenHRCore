<MudNavMenu>
    <MudTooltip Text="Dashboard" Inline=false Arrow=true Placement="Placement.Right">
        <MudNavLink Match=NavLinkMatch.All Icon="@Icons.Material.Outlined.Dashboard" Href="">
            Dashboard
        </MudNavLink>

    </MudTooltip>
    @if (IsShowMenuTitle)
    {
        <MudNavGroup title="Settings" Icon="@Icons.Material.Outlined.Settings" Expanded=true>
            <MudNavLink Icon="@Icons.Material.Outlined.People" Href="/admin/users">Users</MudNavLink>
            <MudNavLink Icon="@Icons.Material.Outlined.AdminPanelSettings" Href="/admin/roles">Roles</MudNavLink>
        </MudNavGroup>

        <MudNavGroup title="Recruitment" Icon="@Icons.Material.Outlined.WorkHistory" Expanded=true>
            <MudNavLink Icon="@Icons.Material.Outlined.People" Href="/admin/users">Users</MudNavLink>
            <MudNavLink Icon="@Icons.Material.Outlined.AdminPanelSettings" Href="/admin/roles">Roles</MudNavLink>
        </MudNavGroup>
    }
    else
    {

        <MudMenu Variant="Variant.Filled">
            <ActivatorContent>

                <MudTooltip Text="Settings" Inline=false Arrow=true Placement="Placement.Right">
                    <MudNavLink Icon="@Icons.Material.Outlined.Settings">Settings</MudNavLink>
                </MudTooltip>
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem>
                    <MudText Typo="Typo.subtitle2" Style="font-weight:bold;">Settings</MudText>
                    <MudText Typo="Typo.body2" Class="text-secondary">Manage Application Settings</MudText>
                </MudMenuItem>
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Outlined.People" Href="/admin/users">Users</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.Lock" Href="/admin/roles">Roles</MudMenuItem>
            </ChildContent>
        </MudMenu>

        <MudMenu Variant="Variant.Filled">
            <ActivatorContent>

                <MudTooltip Text="Recruitment" Inline=false Arrow=true Placement="Placement.Right">
                    <MudNavLink Icon="@Icons.Material.Outlined.WorkHistory">Recruitment</MudNavLink>
                </MudTooltip>
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem>
                    <MudText Typo="Typo.subtitle2" Style="font-weight:bold;">Recruitment</MudText>
                    <MudText Typo="Typo.body2" Class="text-secondary">Manage Recruitment Module</MudText>
                </MudMenuItem>
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Outlined.People" Href="/admin/users">Users</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.Lock" Href="/admin/roles">Roles</MudMenuItem>
            </ChildContent>
        </MudMenu>
    }

