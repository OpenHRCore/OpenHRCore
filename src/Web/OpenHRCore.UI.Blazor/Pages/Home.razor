@page "/"
@using MudBlazor

<PageTitle>Dashbaord</PageTitle>

<MudText Typo="Typo.h6" Style="font-weight:bold;" Class="my-4">Dashboard</MudText>
<MudText Typo="Typo.body2" Class="mb-4"> This is user dashbaord page.</MudText>

<MudGrid>
    <MudItem lg="3" md="3" sm="6" xs="12">
        <MudCard Class="mb-4 rounded-lg" Elevation="2">
            <MudCardHeader>
                <MudText Typo="Typo.subtitle1">Total Users</MudText>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.h4" Class="text-center">150</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem lg="3" md="3" sm="6" xs="12">
        <MudCard Class="mb-4 rounded-lg">
            <MudCardHeader>
                <MudText Typo="Typo.subtitle1">Active Users</MudText>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.h4" Class="text-center">120</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem lg="3" md="3" sm="6" xs="12">
        <MudCard Class="mb-4 rounded-lg">
            <MudCardHeader>
                <MudText Typo="Typo.subtitle1">Inactive Users</MudText>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.h4" Class="text-center">30</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem lg="3" md="3" sm="6" xs="12">
        <MudCard Class="mb-4 rounded-lg">
            <MudCardHeader>
                <MudText Typo="Typo.subtitle1">Pending Requests</MudText>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.h4" Class="text-center">5</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@code{
    private List<BreadcrumbItem> _items =
  [
        new("Dashboard", href: null, disabled: true)
  ];
}

